[Unit]
Description=unidbg MCP Server (slot %i)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Standalone mode: run the self-contained fat jar built from this repo.
# Build first:  JAVA_HOME=<jdk-21> ./mvnw -B -DskipTests package
WorkingDirectory=%h/github/android-unidbg-mcp
EnvironmentFile=%h/.config/unidbg/slot-%i.conf
ExecStartPre=/bin/bash -c 'for i in {1..10}; do ss -ltn | grep -q ":$UNIDBG_PORT " || exit 0; sleep 1; done; exit 1'
ExecStart=java -jar %h/github/android-unidbg-mcp/target/unidbg-mcp.jar
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
